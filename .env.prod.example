# Production environment variables
# Copier ce fichier en .env.prod et remplir toutes les valeurs
# Utilisation : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=planify
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=planify_kids

# ── MongoDB ───────────────────────────────────────────────────────────────────
# URI complète (Atlas ou instance auto-hébergée)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/planify-kids?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 caractères, générer avec : openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL publique du frontend (sans trailing slash)
CORS_ORIGINS=https://app.planify-kids.com

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=80
