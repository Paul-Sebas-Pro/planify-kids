{
  "version": 2,
  "framework": null,
  "installCommand": "pnpm install --frozen-lockfile",
  "buildCommand": "DATABASE_URL=postgresql://build:build@localhost/build pnpm --filter @planify-kids/api db:generate && pnpm --filter @planify-kids/web build",
  "outputDirectory": "apps/web/dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 6 * * *"
    },
    {
      "path": "/api/cron/forgotten",
      "schedule": "0 18 * * *"
    },
    {
      "path": "/api/cron/planning",
      "schedule": "0 12 * * *"
    },
    {
      "path": "/api/cron/calendar",
      "schedule": "0 3 * * 0"
    }
  ]
}
