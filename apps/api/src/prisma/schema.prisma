generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
}

enum Role {
  PARENT
  CHILD
}

enum TaskStatus {
  PENDING
  COMPLETED
  SKIPPED
}

enum ExchangeStatus {
  PENDING
  ACCEPTED
  REFUSED
}

enum RewardStatus {
  PENDING
  APPROVED
  REJECTED
}

enum NotificationType {
  TASK_COMPLETED
  CLAIM_APPROVED
  CLAIM_REJECTED
  TASKS_ASSIGNED
  BADGE_EARNED
  TASKS_REMINDER
  TASKS_FORGOTTEN
}

enum ChallengeStatus {
  ACTIVE
  COMPLETED
  FAILED
}

// Zone vacances scolaires (métropole A/B/C) + territoires DOM-TOM. Détermine
// à la fois la zone jours fériés (calendrier.api.gouv.fr) et la zone vacances
// scolaires (data.education.gouv.fr) — voir services/school-calendar.ts.
// Limite connue : Alsace-Moselle (2 jours fériés en plus) non distingué de
// Zone B ; Saint-Barthélemy/Saint-Martin rattachés à Guadeloupe (pas de zone
// vacances scolaires distincte dans le dataset officiel).
enum CalendarZone {
  ZONE_A
  ZONE_B
  ZONE_C
  GUADELOUPE
  GUYANE
  MARTINIQUE
  LA_REUNION
  MAYOTTE
  NOUVELLE_CALEDONIE
  POLYNESIE_FRANCAISE
  SAINT_PIERRE_ET_MIQUELON
  WALLIS_ET_FUTUNA
}

enum CalendarDayType {
  HOLIDAY
  VACATION
}

enum Slot {
  NOON
  EVENING
}

model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members FamilyMember[]
}

model Family {
  id         String        @id @default(uuid())
  name       String
  code       String?       @unique
  timezone   String        @default("Europe/Paris")
  locale     String        @default("fr")
  schoolZone CalendarZone?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members    FamilyMember[]
  tasks      TaskTemplate[]
  schedules  Schedule[]
  rewards    Reward[]
  challenges FamilyChallenge[]
}

model FamilyMember {
  id       String  @id @default(uuid())
  familyId String
  userId   String?

  name      String
  avatar    String?
  color     String?
  birthDate DateTime?
  role      Role
  pin       String?

  points   Int     @default(0)
  fcmToken String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)
  user   User?  @relation(fields: [userId], references: [id])

  assignments   ScheduleItem[]
  badges        MemberBadge[]
  rewards       RewardClaim[]
  notifications Notification[]

  @@index([familyId])
}

model TaskTemplate {
  id          String  @id @default(uuid())
  familyId    String
  name        String
  description String?
  icon        String?

  difficulty Int
  duration   Int
  points     Int
  frequency  String

  isActive    Boolean @default(true)
  isMandatory Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family        Family         @relation(fields: [familyId], references: [id], onDelete: Cascade)
  scheduleItems ScheduleItem[]

  @@index([familyId])
}

model Schedule {
  id       String @id @default(uuid())
  familyId String

  startDate     DateTime
  endDate       DateTime
  generatedByAI Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  items  ScheduleItem[]

  @@index([familyId])
}

model ScheduleItem {
  id                 String  @id @default(uuid())
  scheduleId         String
  taskTemplateId     String
  assignedToMemberId String

  date        DateTime
  slot        Slot       @default(EVENING)
  status      TaskStatus @default(PENDING)
  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  schedule  Schedule     @relation(fields: [scheduleId], references: [id], onDelete: Cascade)
  task      TaskTemplate @relation(fields: [taskTemplateId], references: [id])
  member    FamilyMember @relation(fields: [assignedToMemberId], references: [id])
  exchanges TaskExchange[]

  @@index([scheduleId])
  @@index([assignedToMemberId])
  @@index([date])
}

model TaskExchange {
  id             String @id @default(uuid())
  scheduleItemId String
  fromMemberId   String
  toMemberId     String

  status ExchangeStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scheduleItem ScheduleItem @relation(fields: [scheduleItemId], references: [id], onDelete: Cascade)
}

model Badge {
  id          String @id @default(uuid())
  name        String
  description String
  icon        String

  conditionType  String
  conditionValue Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members MemberBadge[]
}

model MemberBadge {
  id       String @id @default(uuid())
  memberId String
  badgeId  String

  earnedAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  badge  Badge        @relation(fields: [badgeId], references: [id])

  @@unique([memberId, badgeId])
}

model Reward {
  id         String  @id @default(uuid())
  familyId   String
  name       String
  icon       String
  pointsCost Int
  isActive   Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  family Family        @relation(fields: [familyId], references: [id], onDelete: Cascade)
  claims RewardClaim[]

  @@index([familyId])
}

model RewardClaim {
  id       String @id @default(uuid())
  memberId String
  rewardId String

  status RewardStatus @default(PENDING)

  claimedAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  reward Reward       @relation(fields: [rewardId], references: [id])
}

model Notification {
  id       String           @id @default(uuid())
  memberId String
  familyId String
  type     NotificationType
  message  String
  readAt   DateTime?

  createdAt DateTime @default(now())

  member FamilyMember @relation(fields: [memberId], references: [id], onDelete: Cascade)

  @@index([memberId])
  @@index([familyId])
}

model FamilyChallenge {
  id          String          @id @default(uuid())
  familyId    String
  title       String
  description String?
  targetPoints Int
  bonusPoints  Int
  startDate   DateTime
  endDate     DateTime
  status      ChallengeStatus @default(ACTIVE)
  completedAt DateTime?

  createdAt DateTime @default(now())

  family Family @relation(fields: [familyId], references: [id], onDelete: Cascade)

  @@index([familyId])
}

// Cache local des jours fériés / vacances scolaires par zone (évite un appel
// aux API gouv à chaque génération de planning — voir services/school-calendar.ts).
// Une ligne = un jour non-scolaire pour une zone donnée (férié et/ou vacances,
// les deux peuvent coexister pour la même date via des lignes distinctes).
model SchoolCalendarCache {
  id    String          @id @default(uuid())
  zone  CalendarZone
  date  DateTime        @db.Date
  type  CalendarDayType
  label String?

  createdAt DateTime @default(now())

  @@unique([zone, date, type])
  @@index([zone, date])
}
