# Production environment variables
# Copier ce fichier en .env.prod et remplir toutes les valeurs
# Utilisation : docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

# ── Image ─────────────────────────────────────────────────────────────────────
IMAGE_TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=planify
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=planify_kids

# ── MongoDB ───────────────────────────────────────────────────────────────────
# URI complète (Atlas ou instance auto-hébergée)
MONGODB_URI=mongodb+srv://user:password@cluster.mongodb.net/planify-kids?retryWrites=true&w=majority

# ── JWT ───────────────────────────────────────────────────────────────────────
# Minimum 32 caractères, générer avec : openssl rand -base64 48
JWT_SECRET=change-me-generate-with-openssl-rand-base64-48
JWT_EXPIRES_IN=7d
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ──────────────────────────────────────────────────────────────────────
# URL publique du frontend (sans trailing slash)
CORS_ORIGINS=https://app.planify-kids.com

# ── Ports ─────────────────────────────────────────────────────────────────────
WEB_PORT=80

# ── Sentry (opt-in) ───────────────────────────────────────────────────────────
# Laisser vide pour désactiver la remontée d'erreurs Sentry
# SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX
# VITE_SENTRY_DSN=https://xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx@oXXXXXXX.ingest.sentry.io/XXXXXXX

# ── Firebase FCM (opt-in) ─────────────────────────────────────────────────────
# Laisser vide pour désactiver les notifications push.
# Valeurs depuis Console Firebase → Paramètres du projet → Comptes de service → Générer une clé privée
# FIREBASE_PROJECT_ID=planify-kids-xxxxx
# FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@planify-kids-xxxxx.iam.gserviceaccount.com
# FIREBASE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----\n"
